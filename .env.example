# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# LinkedIn OAuth app credentials
# Create an app at https://www.linkedin.com/developers/apps/new
# Required scopes: openid, profile, w_member_social
# Add http://localhost:8000/callback as an authorized redirect URL
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# LinkedIn access token and person URN
# Run oauth_helper.py once to generate these
LINKEDIN_ACCESS_TOKEN=AQX...
LINKEDIN_PERSON_URN=urn:li:person:...

# GitHub token — optional, raises GitHub API rate limit from 60 to 5000 req/hour
GITHUB_TOKEN=

# Discord bot — used by discord_bot.py to manage pending posts via Discord buttons
# Create a bot at https://discord.com/developers/applications → New Application → Bot
# Invite URL: OAuth2 → URL Generator → scopes: bot
# Required permissions: Send Messages, Embed Links, Attach Files, Use Application Commands
DISCORD_BOT_TOKEN=
# Right-click your channel in Discord → Copy Channel ID (requires Developer Mode enabled)
DISCORD_CHANNEL_ID=

# Author info — used in auto-generated install guides (skills/ folder)
AUTHOR_NAME=Your Name
AUTHOR_TITLE=Your Job Title
AUTHOR_COMPANY=Your Company
WEBSITE_URL=https://yourwebsite.com
LINKEDIN_URL=https://linkedin.com/in/yourprofile
MALT_URL=                        # optional freelance marketplace profile
GITHUB_URL=https://github.com/yourusername
